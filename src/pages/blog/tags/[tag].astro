---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SectionHead from '../../../components/SectionHead.astro';
import PostCard from '../../../components/PostCard.astro';
import TagList from '../../../components/TagList.astro';
import { allTags, getPosts, type Post } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = allTags(posts);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((p) => p.data.tags.includes(tag)), tags },
  }));
}

interface Props { tag: string; posts: Post[]; tags: { tag: string; count: number }[]; }
const { tag, posts, tags } = Astro.props;
---

<BaseLayout title={`Posts tagged ${tag}`} description={`Posts about ${tag} from Pradhi's notebook.`}>
  <div class="page">
    <SectionHead title={`#${tag}`} level={1} divider="squiggle" />
    <TagList tags={tags} current={tag} />
    <div class="list">{posts.map((p) => <PostCard post={p} />)}</div>
  </div>
</BaseLayout>

<style>
  .page { padding-top: 28px; max-width: 820px; }
  .list { display: grid; gap: 34px; margin-top: 34px; }
</style>
