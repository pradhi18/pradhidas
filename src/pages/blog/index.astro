---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHead from '../../components/SectionHead.astro';
import PostCard from '../../components/PostCard.astro';
import TagList from '../../components/TagList.astro';
import { allTags, getPosts } from '../../lib/posts';
import { projectArt } from '../../lib/doodles';
import { url } from '../../lib/url';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="Notes on tech, life and doodles from Pradhi's notebook.">
  <div class="page">
    <SectionHead title="The blog" level={1} divider="coil">
      <a class="box" href={url('blog/archive')}>archive by month →</a>
    </SectionHead>
    <p class="intro">Tech, life, doodles and whatever else ends up in the notebook.</p>
    <TagList tags={allTags(posts)} />
    {posts.length ? (
      <div class="list">{posts.map((p) => <PostCard post={p} />)}</div>
    ) : (
      <div class="empty taped">
        <svg class="pencil" viewBox="0 0 250 112" aria-hidden="true" set:html={projectArt('sprout', 9)} />
        <p class="hand">The first post is still a seedling. Check back soon!</p>
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .page { padding-top: 28px; max-width: 820px; }
  .intro { font-size: 19px; margin: -14px 0 18px; }
  .list { display: grid; gap: 34px; margin-top: 34px; }
  .empty { display: grid; justify-items: center; gap: 6px; padding: 28px 20px; max-width: 520px; margin-top: 30px; }
  .empty svg { width: 220px; height: auto; overflow: visible; }
  .empty p { font-size: 22px; margin: 0; text-align: center; }
</style>
