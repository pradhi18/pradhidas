---
import { projectArt } from '../lib/doodles';

type Stage = 'idea' | 'making' | 'shipped';
interface Props {
  kind: 'code' | 'design' | 'writing';
  title: string;
  description: string;
  art: 'code' | 'design' | 'writing' | 'sprout';
  stage?: Stage; // leave out until the project is real
  tilt?: number;
  tape?: string;
  href?: string;
}
const { kind, title, description, art, stage, tilt = 0, tape = 'var(--sky)', href } = Astro.props;
const stages: Stage[] = ['idea', 'making', 'shipped'];
const current = stage ? stages.indexOf(stage) : -1;
const seeds = { code: 5, design: 6, writing: 7, sprout: 9 };
---

<article class="card taped" style={`--tilt:${tilt}deg; --tape:${tape}`}>
  <svg class="art pencil" viewBox="0 0 250 112" aria-hidden="true" set:html={projectArt(art, seeds[art])} />
  <p class="kind">{kind}</p>
  <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  <p>{description}</p>
  {stage && (
    <ol class="steps" aria-label="Progress">
      {stages.map((s, i) => (
        <li class:list={{ done: i < current, current: i === current }} aria-current={i === current ? 'step' : undefined}>{s}</li>
      ))}
    </ol>
  )}
</article>

<style>
  .card { padding: 20px 22px 24px; transform: rotate(var(--tilt)); transition: transform .35s cubic-bezier(.34, 1.56, .64, 1); }
  .card:hover { transform: rotate(0deg) translateY(-5px); }
  .art { display: block; width: 100%; height: 112px; margin-bottom: 10px; overflow: visible; }
  .kind { font-family: var(--f-hand); font-size: 20px; color: var(--tangerine-ink); margin: 0; }
  h3 { font-family: var(--f-display); font-weight: 400; font-size: 27px; line-height: 1.1; margin: 2px 0 8px; }
  h3 a { color: inherit; text-decoration: none; }
  p { margin: 0; }
  .steps { list-style: none; display: flex; flex-wrap: wrap; gap: 8px 24px; padding: 0; margin: 16px 0 0; }
  .steps li {
    position: relative; font-family: var(--f-hand); font-size: 18px; line-height: 1.35;
    padding: 0 10px; border: 1.4px solid var(--pencil); border-radius: var(--sketch); color: var(--pencil);
  }
  .steps li + li::before { content: "→"; position: absolute; left: -20px; top: 50%; transform: translateY(-52%); font-family: var(--f-body); color: var(--pencil); }
  .steps .done { text-decoration: line-through; text-decoration-thickness: 1.5px; }
  .steps .current { background: var(--tangerine); color: var(--on-accent); border-color: var(--ink); font-weight: 700; }
</style>
