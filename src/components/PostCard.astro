---
import type { Post } from '../lib/posts';
import { formatDate, readingMinutes } from '../lib/posts';
import { flowerFor, jagFrame } from '../lib/doodles';
import { url } from '../lib/url';

interface Props {
  post: Post;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
const href = url(`blog/${post.id}`);
---

<article class:list={['post', { featured }]}>
  {featured && (
    <svg class="jag pencil" viewBox="0 0 620 340" preserveAspectRatio="none" aria-hidden="true" set:html={jagFrame(600, 320)} />
  )}
  <svg class="flower pencil" viewBox="-30 -30 60 60" aria-hidden="true" set:html={flowerFor(post.id)} />
  <div class="body">
    <div class="meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span>{readingMinutes(post)} min read</span>
      {post.data.draft && <span class="draft">draft</span>}
    </div>
    <h3><a href={href}>{post.data.title}</a></h3>
    <p>{post.data.description}</p>
    {post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map((t) => <a class="box small" href={url(`blog/tags/${t}`)}>{t}</a>)}
      </div>
    )}
  </div>
</article>

<style>
  .post { display: grid; grid-template-columns: 58px minmax(0, 1fr); gap: 16px; align-items: start; position: relative; isolation: isolate; }
  .flower { width: 58px; height: 58px; overflow: visible; }
  .featured { grid-template-columns: 1fr; padding: 34px 32px 30px; }
  .featured .flower { width: 80px; height: 80px; }
  .jag { position: absolute; inset: -10px; width: calc(100% + 20px); height: calc(100% + 20px); z-index: -1; overflow: visible; pointer-events: none; }
  .jag :global(path) { vector-effect: non-scaling-stroke; }
  h3 { font-family: var(--f-display); font-weight: 400; font-size: 26px; line-height: 1.12; margin: 0 0 8px; }
  .featured h3 { font-size: clamp(32px, 3.6vw, 44px); }
  h3 a {
    color: inherit; text-decoration: none;
    background-image: linear-gradient(var(--hl), var(--hl)); background-repeat: no-repeat;
    background-size: 0% 42%; background-position: 0 88%; transition: background-size .4s ease;
  }
  h3 a:hover, h3 a:focus-visible { background-size: 100% 42%; }
  p { margin: 0; max-width: 60ch; }
  .meta { display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 14px; color: var(--pencil); margin-bottom: 6px; font-variant-numeric: tabular-nums; }
  .draft { font-family: var(--f-hand); font-size: 17px; line-height: 1.2; color: var(--tangerine-ink); border: 1.4px dashed var(--tangerine-ink); border-radius: 6px; padding: 0 6px; }
  .tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 14px; }
  @media (max-width: 640px) {
    .post { grid-template-columns: 46px minmax(0, 1fr); gap: 12px; }
    .flower { width: 46px; height: 46px; }
    .featured { padding: 26px 20px 24px; }
  }
</style>
